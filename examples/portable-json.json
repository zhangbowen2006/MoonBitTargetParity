{
  "schema_version": 1,
  "package_path": "cmd/probe",
  "targets": ["wasm", "wasm-gc", "js", "native"],
  "timeout_ms": 30000,
  "scenarios": [
    {
      "name": "integer-wrap-and-unicode-json",
      "args": [],
      "stdin": "",
      "policy": {
        "normalize_line_endings": true,
        "trim_one_final_newline": false,
        "compare_stderr": false,
        "compare_stdout_as_json": true,
        "strip_ansi_sgr": false,
        "trim_trailing_whitespace_per_line": false
      },
      "expectations": [
        {
          "target": "wasm",
          "exit_code": 0,
          "stdout": "{\"sum\":42,\"int_wrap\":-2147483648,\"label\":\"MoonBit 月 🚀\",\"ok\":true}\n",
          "stderr": ""
        },
        {
          "target": "wasm-gc",
          "exit_code": 0,
          "stdout": "{\"sum\":42,\"int_wrap\":-2147483648,\"label\":\"MoonBit 月 🚀\",\"ok\":true}\n",
          "stderr": ""
        },
        {
          "target": "js",
          "exit_code": 0,
          "stdout": "{\"sum\":42,\"int_wrap\":-2147483648,\"label\":\"MoonBit 月 🚀\",\"ok\":true}\n",
          "stderr": ""
        },
        {
          "target": "native",
          "exit_code": 0,
          "stdout": "{\"sum\":42,\"int_wrap\":-2147483648,\"label\":\"MoonBit 月 🚀\",\"ok\":true}\n",
          "stderr": ""
        }
      ]
    }
  ]
}
